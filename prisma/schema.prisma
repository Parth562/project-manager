// Prisma schema — Phase 2 (Better Auth) + Phase 3 (Project & Team management)
// + Phase 4 (Requirement management) + Phase 5 (TC10–TC14).

generator client {
  provider = "prisma-client-js"
  // Load `include`d relations in the same SQL query (JOINs) instead of one extra
  // round trip per relation. Each round trip to the remote DB costs ~0.5-1.5s.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROJECT_MANAGER
  DEVELOPER
  TESTER
  FACULTY_CLIENT
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  createdProjects     Project[]       @relation("ProjectCreator")
  projectMemberships  ProjectMember[]
  createdRequirements Requirement[]
  createdUserStories  UserStory[]
  assignedTasks       Task[]          @relation("TaskAssignee")
  createdTasks        Task[]          @relation("TaskCreator")
  createdTestCases    TestCase[]
  reportedBugs        Bug[]           @relation("BugReporter")
  assignedBugs        Bug[]           @relation("BugAssignee")

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --- Phase 3: Project & Team management ---

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdById  String
  createdBy    User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members      ProjectMember[]
  requirements Requirement[]
  userStories  UserStory[]
  tasks        Task[]
  testCases    TestCase[]
  bugs         Bug[]

  @@map("project")
}

// Join model between User and Project.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_member")
}

// --- Phase 4: Requirement management ---

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model Requirement {
  id          String              @id @default(cuid())
  projectId   String
  title       String
  description String
  priority    RequirementPriority
  status      RequirementStatus   @default(TODO)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User        @relation(fields: [createdById], references: [id])
  userStories  UserStory[]
  tasks        Task[]
  testCases    TestCase[]

  @@index([projectId])
  @@map("requirement")
}

// --- Phase 5: TC10/TC11 — User Story management ---

enum UserStoryStatus {
  DRAFT
  APPROVED
  REJECTED
}

model UserStory {
  id                 String          @id @default(cuid())
  projectId          String
  requirementId      String
  storyText          String
  acceptanceCriteria String[]
  status             UserStoryStatus @default(DRAFT)
  isAiGenerated      Boolean         @default(false)
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id])
  tasks       Task[]
  testCases   TestCase[]

  @@index([projectId])
  @@index([requirementId])
  @@map("user_story")
}

// --- Phase 5: TC12/TC13 — Task management ---

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  TESTING
  DONE
}

model Task {
  id            String       @id @default(cuid())
  projectId     String
  requirementId String?
  userStoryId   String?
  title         String
  description   String
  assigneeId    String?
  createdById   String
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  userStory   UserStory?   @relation(fields: [userStoryId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@map("task")
}

// --- Phase 5: TC14 — Test Case management ---

enum TestCaseStatus {
  NOT_EXECUTED
  PASS
  FAIL
  BLOCKED
}

model TestCase {
  id             String         @id @default(cuid())
  projectId      String
  requirementId  String?
  userStoryId    String?
  title          String
  steps          String
  expectedResult String
  actualResult   String?
  status         TestCaseStatus @default(NOT_EXECUTED)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  userStory   UserStory?   @relation(fields: [userStoryId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdById], references: [id])
  bugs        Bug[]

  @@index([projectId])
  @@map("test_case")
}

// --- Phase 5: TC14 — Bug tracking ---

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
}

model Bug {
  id          String      @id @default(cuid())
  projectId   String
  testCaseId  String?
  title       String
  description String
  severity    BugSeverity @default(MEDIUM)
  priority    BugPriority @default(MEDIUM)
  status      BugStatus   @default(OPEN)
  reporterId  String
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  reporter   User      @relation("BugReporter", fields: [reporterId], references: [id])
  assignee   User?     @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("bug")
}
